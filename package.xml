<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ros2_policy_inference</name>
  <version>0.1.0</version>
  <description>
    Standalone ROS2 node that subscribes to a real robot's camera and
    proprioception topics, preprocesses them into the observation format an
    IL/VLA policy was trained on, runs inference, and publishes the
    predicted EE-offset action. Ships with a no-op DummyPolicyModel stub —
    swap it for a trained checkpoint-backed implementation to deploy.
  </description>
  <maintainer email="ximen0806449@gmail.com">Zhong-Zi-Heng</maintainer>
  <license>TODO: License declaration</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
